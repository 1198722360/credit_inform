{
  "monitors": [
    {
      "id": "main-balance",
      "name": "主账号余额",
      "provider": "http",
      "url": "https://example.com/api/balance",
      "method": "GET",
      "headers": {
        "Authorization": "Bearer replace-with-your-api-token"
      },
      "jsonPath": "data.balance",
      "operator": "<",
      "threshold": 10,
      "multiplier": 1,
      "offset": 0,
      "pollIntervalSeconds": 60,
      "timeoutSeconds": 15,
      "errorThreshold": 3,
      "repeatAlertSeconds": 300,
      "enabled": true
    }
  ]
}
